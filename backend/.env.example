# Copy to backend/.env. Secrets stay on the server; never prefix them with VITE_.
WINDOPS_STORAGE_DIR=storage
WINDOPS_TASK_DIR=task
WINDOPS_REFRESH_SECONDS=3600
# Optional paid Open-Meteo account; public weather requests do not need a key.
OPEN_METEO_API_KEY=
# Optional OpenAI assistant. Keep the key on this server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Alternative provider, used only when OPENAI_API_KEY is empty.
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Current measured turbine power. Choose one ingestion method:
# 1. An atomically updated CSV/JSON file (relative to the repository, or absolute).
WINDOPS_TELEMETRY_FILE=
# 2. POST /api/telemetry with this separate secret in the X-Telemetry-Key header.
# Leave the file setting empty for API ingestion. No external AI key is needed.
WINDOPS_TELEMETRY_KEY=
# Maximum measurement age, in seconds; default allows two 10-minute intervals.
WINDOPS_TELEMETRY_MAX_AGE_SECONDS=1200
