# Copy to backend/.env. Secrets stay on the server; never prefix them with VITE_.
WINDOPS_STORAGE_DIR=storage
WINDOPS_TASK_DIR=task
WINDOPS_REFRESH_SECONDS=3600
# Optional paid Open-Meteo account; public weather requests do not need a key.
OPEN_METEO_API_KEY=
# Optional external language model. Both settings are required to enable it.
NVIDIA_API_KEY=
NVIDIA_MODEL=
